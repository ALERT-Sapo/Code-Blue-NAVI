
<div style="display:flex;flex-direction:column;align-items:center;gap:16px;padding:20px;background:#080c10;min-height:300px">
<div style="font-size:12px;color:#5a7a9a;letter-spacing:2px;text-transform:uppercase">Code Blue Navi — Icon</div>
<canvas id="iconCanvas" width="512" height="512" style="border-radius:24px;width:200px;height:200px"></canvas>
<button id="dlBtn" style="background:#003a4d;border:1px solid #0088aa;border-radius:8px;color:#00d4ff;font-size:14px;font-weight:700;padding:12px 28px;cursor:pointer;font-family:sans-serif">⬇ Download icon.png</button>
</div>
<script>
var canvas=document.getElementById('iconCanvas');
var ctx=canvas.getContext('2d');
var S=512;

ctx.beginPath();
var r=80;
ctx.moveTo(r,0);ctx.lineTo(S-r,0);ctx.quadraticCurveTo(S,0,S,r);
ctx.lineTo(S,S-r);ctx.quadraticCurveTo(S,S,S-r,S);
ctx.lineTo(r,S);ctx.quadraticCurveTo(0,S,0,S-r);
ctx.lineTo(0,r);ctx.quadraticCurveTo(0,0,r,0);
ctx.closePath();ctx.fillStyle='#080c10';ctx.fill();

var cx=256,cy=270;

function bez(p0,p1,p2,p3,n){
  n=n||80;var pts=[];
  for(var i=0;i<=n;i++){
    var t=i/n,u=1-t;
    pts.push([u*u*u*p0[0]+3*u*u*t*p1[0]+3*u*t*t*p2[0]+t*t*t*p3[0],
              u*u*u*p0[1]+3*u*u*t*p1[1]+3*u*t*t*p2[1]+t*t*t*p3[1]]);
  }
  return pts;
}

function drawPath(segs,color,lw){
  ctx.beginPath();var first=true;
  segs.forEach(function(pts){pts.forEach(function(p){
    if(first){ctx.moveTo(cx+p[0],cy+p[1]);first=false;}
    else ctx.lineTo(cx+p[0],cy+p[1]);
  });});
  ctx.strokeStyle=color;ctx.lineWidth=lw;ctx.lineCap='butt';ctx.lineJoin='round';ctx.stroke();
}

function fillPath(segs,color){
  ctx.beginPath();var first=true;
  segs.forEach(function(pts){pts.forEach(function(p){
    if(first){ctx.moveTo(cx+p[0],cy+p[1]);first=false;}
    else ctx.lineTo(cx+p[0],cy+p[1]);
  });});
  ctx.closePath();ctx.fillStyle=color;ctx.fill();
}

var ySegs=[bez([0,110],[-115,30],[-170,-30],[-170,-100]),bez([-170,-100],[-170,-165],[-120,-205],[-70,-205]),bez([-70,-205],[-35,-205],[-6,-190],[0,-162])];
var cSegs=[bez([0,-162],[6,-190],[35,-205],[70,-205]),bez([70,-205],[120,-205],[170,-165],[170,-100]),bez([170,-100],[170,-30],[115,30],[0,110])];
var gSegs=[bez([0,110],[40,155],[110,170],[0,210])];
var oSegs=[bez([0,210],[-110,170],[-40,155],[0,110])];

var lw=66;
drawPath(ySegs,'#ffe600',lw);
drawPath(cSegs,'#00d4ff',lw);
drawPath(gSegs,'#00ff88',lw);
drawPath(oSegs,'#ff7700',lw);

fillPath([bez([0,-162],[6,-190],[35,-205],[70,-205]),bez([70,-205],[120,-205],[170,-165],[170,-100]),bez([170,-100],[170,-30],[115,30],[0,110]),bez([0,110],[-115,30],[-170,-30],[-170,-100]),bez([-170,-100],[-170,-165],[-120,-205],[-70,-205]),bez([-70,-205],[-35,-205],[-6,-190],[0,-162])],'#080c10');
fillPath([bez([0,110],[40,155],[110,170],[0,210]),bez([0,210],[-110,170],[-40,155],[0,110])],'#080c10');

var ipts=bez([-32,-178],[-16,-218],[16,-218],[32,-178]);
ctx.beginPath();ipts.forEach(function(p,i){if(i===0)ctx.moveTo(cx+p[0],cy+p[1]);else ctx.lineTo(cx+p[0],cy+p[1]);});
ctx.strokeStyle='#080c10';ctx.lineWidth=58;ctx.lineCap='round';ctx.stroke();

var ekg=[[-130,-40],[-100,-40],[-88,-62],[-75,-40],[-58,-40],[-50,-22],[-40,-118],[-30,10],[-18,-40],[8,-40],[20,-62],[32,-40],[130,-40]];
ctx.beginPath();ekg.forEach(function(p,i){if(i===0)ctx.moveTo(cx+p[0],cy+p[1]);else ctx.lineTo(cx+p[0],cy+p[1]);});
ctx.strokeStyle='#00ff88';ctx.lineWidth=12;ctx.lineCap='round';ctx.lineJoin='round';ctx.globalAlpha=0.95;ctx.stroke();ctx.globalAlpha=1;

var kx=cx,ky=cy-162;
ctx.beginPath();
ctx.moveTo(kx,ky+30);ctx.lineTo(kx+13,ky);ctx.lineTo(kx,ky-16);ctx.lineTo(kx-13,ky);
ctx.closePath();ctx.fillStyle='#ff3355';ctx.fill();

document.getElementById('dlBtn').onclick=function(){
  var a=document.createElement('a');a.download='icon.png';a.href=canvas.toDataURL('image/png');a.click();
};
</script>
